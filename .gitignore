# ==============================================================================
# FoodVision 1.0 - .gitignore
# Comprehensive exclusions for Python, PyTorch, FastAPI, Datasets, and Logs
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/

# --- Deep Learning Models, Weights & Checkpoints ---
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.h5
models/*.pt
models/*.pth
checkpoints/

# --- Large Datasets & Archives ---
data/food-101/
food-101/
food-101.zip
*.tar.gz
*.zip
*.tar
data/*.zip
data/*.tar.gz

# --- Application Logs ---
logs/*.log
*.log
!logs/.gitkeep

# --- Scratch & Temporary Experiment Files ---
scratch/
tmp/
temp/

# --- Secrets, API Keys & Credentials ---
.env
.env.*
!.env.example
kaggle.json
secrets/

# --- IDE & Editor Files ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
